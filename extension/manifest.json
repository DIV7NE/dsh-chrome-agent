{
  "manifest_version": 3,
  "name": "DSH Chrome Agent",
  "version": "0.1.0",
  "description": "Connects your real, logged-in Chrome to DeepSeek Harness so its agent can read and drive the tabs you already have open.",
  "minimum_chrome_version": "116",
  "key": "",
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "activeTab"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "DSH Chrome Agent"
  }
}
